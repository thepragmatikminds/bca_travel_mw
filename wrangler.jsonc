{
  // Cloudflare Workers — static assets. `npm run build` writes ./dist, wrangler uploads it.
  // Unknown URLs (e.g. /book, /services) fall back to index.html so the single-page app can route them.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bca-travel",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
